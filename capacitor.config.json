{
  "appId": "com.kerala.prayertimes",
  "appName": "Basmalah",
  "webDir": "www",
  "backgroundColor": "#0A4D3A",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "never" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "backgroundColor": "#0A4D3A", "showSpinner": false, "launchAutoHide": true },
    "LocalNotifications": { "smallIcon": "ic_stat_prayer", "iconColor": "#0A4D3A", "presentationOptions": ["badge", "banner", "list"] },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0A4D3A", "overlaysWebView": false }
  }
}
