{
  "name": "kerala-prayer-times",
  "version": "2.0.0",
  "description": "Kerala Prayer Times - accurate namaz times, adhan, Qibla and adhkar for Android and iPhone",
  "private": true,
  "scripts": {
    "setup:native": "node scripts/native-setup.mjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#0B5D4B' --iconBackgroundColorDark '#0B5D4B' --splashBackgroundColor '#0B5D4B' --splashBackgroundColorDark '#06261F'",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "serve": "npx http-server www -p 8080 -c-1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "xcode": "^3.0.1"
  }
}
